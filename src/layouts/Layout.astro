---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { content, siteRepo, type Locale } from '../data/site';
interface Props { locale: Locale; title?: string; description?: string; noindex?: boolean; }
const { locale, title, description, noindex = false } = Astro.props;
const t = content[locale];
const route = locale === 'tr' ? '/' : '/en/';
const sections = ['manifesto', 'architecture', 'development'];
const navHref = (index: number) => `${Astro.url.pathname === route ? '' : route}#${sections[index]}`;
const canonical = new URL(Astro.url.pathname, 'https://umayos.org').href;
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'UMAY OS', url: 'https://umayos.org', inLanguage: ['tr', 'en'], description: t.meta.description, sameAs: [siteRepo] };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1F3A" />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('umayos-theme'); } catch {}
        const theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href="https://umayos.org/" />
    <link rel="alternate" hreflang="en" href="https://umayos.org/en/" />
    <link rel="alternate" hreflang="x-default" href="https://umayos.org/" />
    <link id="umay-favicon" rel="icon" type="image/png" sizes="32x32" href="/umay-icons/light/favicon-32x32.png" media="(prefers-color-scheme: light)" />
    <link id="umay-favicon-dark" rel="icon" type="image/png" sizes="32x32" href="/umay-icons/dark/favicon-32x32.png" media="(prefers-color-scheme: dark)" />
    <link id="umay-apple-icon" rel="apple-touch-icon" sizes="180x180" href="/umay-icons/light/apple-touch-icon.png" />
    <link id="umay-manifest" rel="manifest" href="/umay-icons/light/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UMAY OS" />
    <meta property="og:title" content={title ?? t.meta.title} />
    <meta property="og:description" content={description ?? t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta property="og:image" content="https://umayos.org/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UMAY OS — Models change. Experience endures. Decisions remain human." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="header">
      <div class="container header-inner">
        <a class="wordmark" href={route} aria-label={`UMAY OS · ${t.home}`}><span class="brand-icons" aria-hidden="true"><img class="brand-light" src="/umay-icons/light/icon-128.png" width="48" height="48" alt="" /><img class="brand-dark" src="/umay-icons/dark/icon-128.png" width="48" height="48" alt="" /></span><span><strong>UMAY</strong> OS</span></a>
        <nav aria-label={locale === 'tr' ? 'Ana gezinme' : 'Main navigation'}>{t.nav.map((label, i) => <a href={navHref(i)}>{label}</a>)}</nav>
        <div class="header-tools">
          <div class="languages" aria-label={locale === 'tr' ? 'Dil' : 'Language'}><a href="/" lang="tr" hreflang="tr" aria-current={locale === 'tr' ? 'page' : undefined} data-language="tr">TR</a><span aria-hidden="true">/</span><a href="/en/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined} data-language="en">EN</a></div>
          <button class="theme-toggle" data-theme-toggle data-label-light={locale === 'tr' ? 'Açık temaya geç' : 'Switch to light theme'} data-label-dark={locale === 'tr' ? 'Karanlık temaya geç' : 'Switch to dark theme'} aria-label={locale === 'tr' ? 'Karanlık temaya geç' : 'Switch to dark theme'} hidden>
            <svg class="theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14a9 9 0 0 1-10.5-10.5A9 9 0 1 0 20.5 14Z" /></svg>
            <svg class="theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          </button>
          <a href={siteRepo} class="github">GitHub <Arrow /></a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer dark"><div class="container footer-inner"><div><a class="wordmark" href={route}><span><strong>UMAY</strong> <span class="accent">OS</span></span></a><p>Unified Multi-Agent Advisor for Yield</p></div><div><nav aria-label={locale === 'tr' ? 'Alt gezinme' : 'Footer navigation'}>{t.nav.map((label, i) => <a href={navHref(i)}>{label}</a>)}</nav><p>{t.closing.note}</p></div></div></footer>
    <script>import '../scripts/theme'; import '../scripts/interactions';</script>
  </body>
</html>
