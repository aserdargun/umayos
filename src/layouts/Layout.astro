---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
import { content, siteRepo, type Locale } from '../data/site';
interface Props { locale: Locale; title?: string; description?: string; noindex?: boolean; }
const { locale, title, description, noindex = false } = Astro.props;
const t = content[locale];
const route = locale === 'tr' ? '/' : '/en/';
const sections = ['manifesto', 'architecture', 'development'];
const navHref = (index: number) => `${Astro.url.pathname === route ? '' : route}#${sections[index]}`;
const canonical = new URL(Astro.url.pathname, 'https://umayos.org').href;
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'UMAY OS', url: 'https://umayos.org', inLanguage: ['tr', 'en'], description: t.meta.description, sameAs: [siteRepo] };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1F3A" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href="https://umayos.org/" />
    <link rel="alternate" hreflang="en" href="https://umayos.org/en/" />
    <link rel="alternate" hreflang="x-default" href="https://umayos.org/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UMAY OS" />
    <meta property="og:title" content={title ?? t.meta.title} />
    <meta property="og:description" content={description ?? t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta property="og:image" content="https://umayos.org/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UMAY OS — Models change. Experience endures. Decisions remain human." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="header dark">
      <div class="container header-inner">
        <a class="wordmark" href={route} aria-label={`UMAY OS · ${t.home}`}>UMAY OS</a>
        <nav aria-label={locale === 'tr' ? 'Ana gezinme' : 'Main navigation'}>{t.nav.map((label, i) => <a href={navHref(i)}>{label}</a>)}</nav>
        <div class="header-tools">
          <div class="languages" aria-label={locale === 'tr' ? 'Dil' : 'Language'}><a href="/" lang="tr" hreflang="tr" aria-current={locale === 'tr' ? 'page' : undefined} data-language="tr">TR</a><span aria-hidden="true">/</span><a href="/en/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined} data-language="en">EN</a></div>
          <a href={siteRepo} class="github">GitHub <Arrow /></a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="footer dark"><div class="container footer-inner"><div><a class="wordmark" href={route}>UMAY OS</a><p>Unified Multi-Agent Advisor for Yield</p></div><div><nav aria-label={locale === 'tr' ? 'Alt gezinme' : 'Footer navigation'}>{t.nav.map((label, i) => <a href={navHref(i)}>{label}</a>)}</nav><p>{t.closing.note}</p></div></div></footer>
    <script>import '../scripts/interactions';</script>
  </body>
</html>
