---
interface Props { name: 'hero' | 'teacher' | 'archive'; alt: string; priority?: boolean; class?: string; }
const { name, alt, priority = false, class: className = '' } = Astro.props;
const set = (format: string, mobile = false) => (mobile ? [480, 956] : [480, 960, 1536]).map(w => `/assets/${name}${mobile ? '-mobile' : ''}-${w}.${format} ${w}w`).join(', ');
const sizes = name === 'hero' ? '(max-width: 900px) 100vw, 42vw' : name === 'teacher' ? '(max-width: 900px) 100vw, 65vw' : '(max-width: 900px) 100vw, 45vw';
---
<picture class={className}>
  <source type="image/avif" srcset={set('avif', name === 'hero')} sizes={sizes} />
  <img src={name === 'hero' ? '/assets/hero-mobile-956.webp' : `/assets/${name}-960.webp`} srcset={set('webp', name === 'hero')} sizes={sizes} width={name === 'hero' ? 956 : 1536} height="1024" alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
</picture>
