---
import { content, type Locale } from '../data/site';
import Arrow from './Arrow.astro';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale];
const reelCaption = locale === 'tr' ? 'Türkçe' : 'English';
---
<section class="hero dark" aria-labelledby="hero-title" id="hero">
  <div class="container hero-inner">
    <div class="hero-copy"><h1 id="hero-title">{t.hero.lines.map((line, i) => <span class:list={[i === 1 && 'accent', i === 2 && 'hero-human']}>{line}</span>)}</h1><p class="hero-description">{t.hero.description}</p><div class="hero-actions"><a class="button primary" href="#manifesto">{t.hero.actions[0]} <Arrow /></a><a class="button hero-secondary" href="#architecture">{t.hero.actions[1]} <Arrow /></a></div></div>
    <div class="hero-emblem-wrap">
      <div class="hero-emblem" aria-hidden="true" data-reel-surface><div class="emblem-orbit"></div><img src="/umay-icons/light/icon-512.png" srcset="/umay-icons/light/icon-512.png 512w, /umay-icons/light/icon-1024.png 1024w" data-icon-light="/umay-icons/light/icon-512.png" data-icon-dark="/umay-icons/dark/icon-512.png" data-srcset-light="/umay-icons/light/icon-512.png 512w, /umay-icons/light/icon-1024.png 1024w" data-srcset-dark="/umay-icons/dark/icon-512.png 512w, /umay-icons/dark/icon-1024.png 1024w" sizes="(max-width: 600px) 230px, (max-width: 900px) 280px, 34vw" width="512" height="512" alt="" fetchpriority="high" decoding="async" /></div>
      <button class="reel-trigger" type="button" data-reel-open hidden><svg class="reel-trigger-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72L19 12 8 5.14Z" /></svg><span class="reel-trigger-label">{t.hero.reel.trigger}</span><span class="reel-trigger-hint">{t.hero.reel.hint}</span></button>
    </div>
    <div class="hero-baseline"><p class="hero-note">{t.hero.note}</p><a href="#manifesto" class="hero-scroll" aria-label={t.hero.actions[0]}><Arrow /></a></div>
  </div>
</section>
<dialog class="reel-dialog" data-reel-dialog aria-labelledby="reel-title" aria-describedby="reel-note">
  <div class="reel-dialog-inner">
    <div class="reel-dialog-head">
      <h2 id="reel-title">{t.hero.reel.title}</h2>
      <button class="reel-close" type="button" data-reel-close aria-label={t.hero.reel.close}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg></button>
    </div>
    <video class="reel-video" data-reel-video src="/assets/umay-reel.mp4" width="2560" height="1440" controls playsinline preload="none"><track kind="captions" src={locale === 'tr' ? '/assets/umay-reel.tr.vtt' : '/assets/umay-reel.en.vtt'} srclang={locale} label={reelCaption} /></video>
    <p class="reel-note" id="reel-note">{t.hero.reel.note}</p>
  </div>
</dialog>
