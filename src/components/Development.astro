---
import { content, sources, reviewedOn, type Locale } from '../data/site';
import Arrow from './Arrow.astro';
import SectionLabel from './SectionLabel.astro';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].development;
---
<section id="development" class="section container" aria-labelledby="development-title"><div class="development-topline"><SectionLabel number="05" name="development" locale={locale} /><p class="review-date"><time datetime={reviewedOn}>{t.date}</time></p></div><h2 id="development-title">{t.title}</h2><div class="status-columns"><article><span class="number" aria-hidden="true">01</span><h3>{t.columns[0]}</h3><p>{t.sourceIntro}</p><div class="source-list">{sources.map(source => <div><a href={`${source.repo}/tree/${source.pin}`} class="source-title">{source.name} <Arrow /></a><p>{source.role[locale]}</p><a href={`${source.repo}/commit/${source.pin}`} class="source-pin" aria-label={`${source.name} commit ${source.pin}`}>{source.pin}</a></div>)}</div></article><article><span class="number" aria-hidden="true">02</span><h3>{t.columns[1]}</h3><ul class="editorial-list">{t.decisions.map(text => <li>{text}</li>)}</ul></article><article><span class="number" aria-hidden="true">03</span><h3>{t.columns[2]}</h3><ul class="editorial-list">{t.pending.map(text => <li>{text}</li>)}</ul></article></div><ol class="roadmap">{t.roadmap.map(([title, text], i) => <li><span class="number" aria-hidden="true">0{i + 1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol><p class="technical-note">{t.note}</p></section>
