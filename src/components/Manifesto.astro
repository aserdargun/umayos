---
import { content, type Locale } from '../data/site';
import SectionLabel from './SectionLabel.astro';
const { locale } = Astro.props as { locale: Locale };
const t = content[locale].manifesto;
---
<section id="manifesto" class="section container" aria-labelledby="manifesto-title">
  <div class="manifesto-layout">
    <div class="manifesto-lead"><SectionLabel number="01" name="manifesto" locale={locale} /><div class="manifesto-heading"><h2 id="manifesto-title">{t.title.map(line => <span>{line}</span>)}</h2><p class="manifesto-intro">{t.intro}</p></div></div>
    <ol class="principles">{t.principles.map(([title, text], i) => <li><span class="number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
  </div>
</section>
<div class="quote-band dark"><div class="container"><blockquote>{t.quote.map(line => <span>{line}</span>)}</blockquote></div></div>
