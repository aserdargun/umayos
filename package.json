{
  "name": "umayos-manifesto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/astro.mjs dev --host 127.0.0.1 --port 4321 --background",
    "stop": "node scripts/astro.mjs dev stop",
    "status": "node scripts/astro.mjs dev status",
    "logs": "node scripts/astro.mjs dev logs",
    "dev": "node scripts/astro.mjs dev --host 0.0.0.0 --port 4321",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 0.0.0.0 --port 4321",
    "check": "node scripts/astro.mjs check",
    "test:content": "node scripts/check-content.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run check && npm run build && npm run test:content && npm run test:e2e",
    "assets": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
